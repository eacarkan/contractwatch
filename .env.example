# Copy to .env for local development. Never commit real values.

# Postgres. Local development uses the Docker database from `pnpm db:up`.
# Deployed environments use Neon's pooled connection string.
DATABASE_URL="postgresql://contractwatch@localhost:54329/contractwatch"

# Neon's direct connection string, used only by Prisma Migrate. Not needed locally.
# The Neon integration for Vercel sets this automatically.
# DATABASE_URL_UNPOOLED=""

# Vercel Blob store. Connecting the store to the project sets this, and Vercel
# signs requests itself. Leave unset locally: uploads then go to the gitignored
# .local-blob/ folder.
# BLOB_STORE_ID=""
