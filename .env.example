# Copy to .env for local development. Never commit real values.

# Postgres. Local development uses the Docker database from `pnpm db:up`.
# Deployed environments use Neon's pooled connection string.
DATABASE_URL="postgresql://contractwatch@localhost:54329/contractwatch"

# Neon's direct connection string, used only by Prisma Migrate. Not needed locally.
# The Neon integration for Vercel sets this automatically.
# DATABASE_URL_UNPOOLED=""

# Vercel Blob store. Connecting the store to the project sets this, and Vercel
# signs requests itself. Leave unset locally: uploads then go to the gitignored
# .local-blob/ folder.
# BLOB_STORE_ID=""

# Model service for extraction: any OpenAI-compatible endpoint. Without these,
# everything except extraction still works. Leave them unset on the public site,
# so that visitors cannot use up the quota.
#
# Model on this computer, with no key (Ollama):
#   LLM_BASE_URL="http://localhost:11434/v1"
#   LLM_MODEL="<a model from `ollama list`>"
#   LLM_REASONING_EFFORT="none"   # for a thinking model that times out
# Gemini free tier. Its terms allow free-tier text to be used for training, so
# send it public or anonymised text only:
#   LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#   LLM_API_KEY=""
#   LLM_MODEL="<a free-tier model from Google AI Studio>"
# Groq free tier:
#   LLM_BASE_URL="https://api.groq.com/openai/v1"
#   LLM_API_KEY=""
#   LLM_MODEL="<a free-tier model from the Groq console>"

# Optional. Puts the shared demonstration behind one password. It is a demo gate,
# not production authentication. Leave it unset to run without one.
# DEMO_PASSWORD=""
