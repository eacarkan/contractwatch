{
  "name": "contractwatch",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "split:preview": "tsx scripts/split-preview.ts",
    "anonymise": "tsx scripts/anonymise.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed.ts",
    "specimen:load": "tsx --conditions=react-server --env-file=.env scripts/load-specimen.ts",
    "review:key": "tsx --conditions=react-server --env-file=.env scripts/review-from-key.ts",
    "snapshot": "tsx --conditions=react-server --env-file=.env scripts/snapshot.ts",
    "extract": "tsx --conditions=react-server --env-file=.env scripts/extract.ts",
    "eval": "tsx --conditions=react-server --env-file=.env scripts/eval.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/blob": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.66.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
